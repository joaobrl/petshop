# Copie para web/.env.local para sobrescrever a base das chamadas.
# Ausente = http://localhost:8080 (gateway-service do docker compose).
# Sem barra no final. Lida no build/dev do Vite, então reinicie o servidor
# depois de mudar.
# VITE_API_BASE_URL=http://localhost:8080

# Login via Keycloak (SDD-024 F3), Authorization Code + PKCE no client público
# "web". Ausentes = Keycloak do docker compose.
# VITE_KEYCLOAK_URL=http://localhost:8180
# VITE_KEYCLOAK_REALM=petshop
# VITE_KEYCLOAK_CLIENT_ID=web
