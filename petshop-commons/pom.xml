<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.petshop</groupId>
    <artifactId>petshop-commons</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>petshop-commons</name>
    <description>Shared library for Petshop microservices</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Mesmas versões dos serviços: spring-boot.version = parent
             spring-boot-starter-parent deles, spring-cloud.version =
             spring-cloud-dependencies deles. Subir junto com os serviços. -->
        <spring-boot.version>4.0.3</spring-boot.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>

    <!-- Módulo não herda spring-boot-starter-parent (é uma lib pura, sem
         starter), então importa os BOMs que os serviços usam: compila e testa
         contra o mesmo Spring Framework / Security / Jackson / Feign que roda
         neles, em vez de versões fixadas à mão. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Web: fornece ProblemDetail, ResponseEntity, anotações -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Context: necessário para @RestControllerAdvice -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Web MVC: NoResourceFoundException e NoHandlerFoundException
             (404 de rota inexistente) usados pelo BaseExceptionHandler -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring TX: DataIntegrityViolationException e DuplicateKeyException
             (org.springframework.dao) usados pelo BaseExceptionHandler -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Bean Validation: MethodArgumentNotValidException -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Security: AccessDeniedException (filtro de ownership nos
             endpoints de listagem/busca por ID). "provided" porque, dos
             serviços que usam petshop-commons, só o notification-service não
             tem resource server OAuth2 no classpath — e esse não usa
             BaseExceptionHandler. Os outros cinco já trazem spring-security-
             core transitivamente via spring-boot-starter-oauth2-resource-
             server, então nada muda pra eles. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Resource Server (SDD-024 F2): JwtDecoder via JWKS do Keycloak e o
             conversor Jwt -> AuthenticatedUser (security.oauth2). "provided":
             cada serviço que valida token declara
             spring-boot-starter-oauth2-resource-server. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Client Credentials (SDD-024 F4) do TokenPropagation. "provided": só
             os serviços chamadores (booking/order/staff) declaram
             spring-security-oauth2-client. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-client</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Servlet API: HttpServletRequest/Response usados pelo
             ProblemDetailAccessDeniedHandler e pelo
             ProblemDetailAuthenticationEntryPoint. "provided" pelo mesmo motivo do
             spring-web/spring-security-core acima: todo serviço que usa
             petshop-commons já é uma app web Spring Boot e já traz isso. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OpenFeign: RequestInterceptor usado pelo CorrelationIdFeignConfig.
             "provided": só quem usa Feign (e importa a config) precisa dele.
             Versão vem do spring-cloud-dependencies importado acima. -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Dependências de teste: versões do BOM do Spring Boot importado. -->
        <!-- slf4j-api sozinho (acima, "provided") não tem implementação —
             sem um binding, org.slf4j.MDC vira NOP (put/get não fazem
             nada), o que tornaria um teste de CorrelationIdFilter que
             verifica o MDC sempre verde mesmo se a lógica quebrasse.
             slf4j-simple NÃO serve aqui: o binding dele não implementa
             MDCAdapter de verdade. logback-classic é o binding real que
             cada serviço já traz via spring-boot-starter em runtime; aqui
             só precisamos dele pra rodar os testes deste módulo isolado. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Jackson 3, o que os serviços trazem via spring-boot-starter-json:
             conversor JSON da resposta do token endpoint usado por
             TokenPropagation.clientCredentials nos testes. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>