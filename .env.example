# Variáveis novas do Keycloak (SDD-024). Copie para .env e preencha;
# o .env real não é versionado.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET_CUSTOMER_MANAGEMENT_ADMIN=
KEYCLOAK_CLIENT_SECRET_BOOKING_SERVICE=
KEYCLOAK_CLIENT_SECRET_ORDER_SERVICE=
KEYCLOAK_CLIENT_SECRET_STAFF_SERVICE=

# SMTP do realm petshop (SDD-024 F3): e-mails de definir senha (funcionario criado
# pelo admin, ADMIN inicial sem senha) e de "Esqueci a senha" do Keycloak.
# Padrao: SMTP relay da Brevo (login SMTP e chave SMTP da conta Brevo, nao a API key).
KEYCLOAK_SMTP_HOST=smtp-relay.brevo.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=

# Seed de funcionarios de dev no customer-management (so com o profile dev):
# SPRING_PROFILES_ACTIVE=dev
# DEV_SEED_STAFF_PASSWORD=Petshop@dev123
